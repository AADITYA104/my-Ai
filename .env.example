# Local Ollama/Qwen configuration (primary)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=ultron-core
# Optional: install an embedding model and set it here, otherwise RAG uses keyword fallback.
OLLAMA_EMBED_MODEL=

# Cloud fallback configuration
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Anthropic Claude API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5

# Voyage AI Embeddings for RAG & Vector Memory (optional)
VOYAGE_API_KEY=your_voyage_api_key_here
VOYAGE_MODEL=voyage-3-lite

# Filesystem Sandboxing / Scoping
FREEZE_DIR=./workspace

# Telegram Gateway & Scheduler Alerts
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
ALLOWED_CHAT_IDS=123456789,987654321
REPORT_CHAT_ID=123456789

# HTTP API Security — set an API key before exposing ultron-server.js beyond
# localhost. Sent as an X-API-Key header (or ?apiKey= query param).
ULTRON_API_KEY=
HOST=127.0.0.1

# Text-chat fallback password (required — no default is shipped for security)
TEXT_CHAT_PASSWORD=

# Encrypted local memory vault key (required for a key that survives a
# fresh clone/reinstall — otherwise a random one is generated and stored
# locally at agent-memory/.local_key)
MEMORY_ENCRYPTION_KEY=

# Voice biometric lock — set to "true" to require a verified voice match
# before executing voice commands (requires agent-memory/owner_voice.npy)
VOICE_LOCK_STRICT=false

# Reflection + confidence-gate self-review — opt-in since each check costs
# an extra LLM call. Only applies to coding/audit task types when enabled.
ULTRON_ENABLE_REFLECTION=false
